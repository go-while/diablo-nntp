#!/bin/sh

##  Install build packages and build Diablo for the e2e tests on a test
##  machine.  Run as root from the top of a Diablo source tree copy:
##
##      tests/e2e/ci/build-on-host
##
##  Linux (apt, dnf, zypper, pacman, apk or emerge), FreeBSD and illumos
##  (OmniOS) with pkg are supported; the package manager is chosen from the
##  system.  This copy's lib/vendor.h is changed: RADIUS is turned off (Linux
##  and illumos have no BSD libradius, and FreeBSD's base libradius is not
##  wired up here), and DB_ENABLED and REJECT_DB are turned off when the
##  system has no Berkeley DB 1.85 API (db_185.h; several distributions
##  dropped Berkeley DB, and the BSD/illumos base systems do not ship it).
##  The binaries end up in dbin/.  The news user and group are created when
##  missing (diablo switches to them at startup).  With E2E_FAKE_SENDMAIL=1
##  the moderation tests' fake sendmail is installed as /usr/sbin/sendmail
##  where no sendmail exists (Linux only; see ci/fake-sendmail).  With
##  E2E_NO_CANLOCK=1 Cancel-Lock (CANLOCK_ENABLED) is built out even if
##  libcanlock is installed, to test the build without it.

set -eu

# FreeBSD has no /etc/os-release, and its base `make` is BSD make, not GNU
# make -- so the OS is chosen from uname before anything else, and the GNU
# Makefile is driven with gmake on FreeBSD/illumos.
os=$(uname -s)

if [ "$os" = Linux ]; then

. /etc/os-release
echo "== $PRETTY_NAME"

# Packages are installed only when missing: have() is the distribution's own
# query for one package, and missing() lists those of its arguments not
# installed.  Berkeley DB is optional: install it where the distribution still
# has it.  wantdb() is true when db_185.h is absent and no earlier attempt
# failed; after an attempt, enddb() leaves a marker (outside the wiped build
# directory) if db_185.h is still absent, so later builds skip the attempt.
nodbmark=/var/tmp/diablo-e2e-no-berkeley-db
wantdb() {
    [ ! -e /usr/include/db_185.h ] || return 1
    if [ -e "$nodbmark" ]; then
        echo "build-on-host: berkeley db install skipped (failed before; rm $nodbmark to retry)"
        return 1
    fi
}
enddb() { [ -e /usr/include/db_185.h ] || { true > "$nodbmark"; } 2>/dev/null || true; }
missing() {
    for p; do have "$p" >/dev/null 2>&1 || printf '%s ' "$p"; done
}
report() {
    if [ -n "$need" ]; then echo "build-on-host: installing: $need"
    else echo "build-on-host: all packages present"; fi
}
# Besides the compiler and headers, the e2e run itself needs a few runtime tools
# that minimal container images leave out: procps (pgrep, which diablo-ctl uses
# to find a site's dnewslink and its children), util-linux on the dnf distros
# (su, to drop to the news user while the tests run), and linux-headers on
# Alpine/musl (lib/config.h includes <linux/version.h>).  They are no-ops on a
# full install, where these are already present.
if command -v apt-get >/dev/null; then
    have() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'ok installed'; }
    need=$(missing build-essential libssl-dev zlib1g-dev procps); report
    nodb=; if wantdb && ! have libdb5.3-dev; then nodb=1; fi
    if [ -n "$need" ] || [ -n "$nodb" ]; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get -qq update
        [ -z "$need" ] || apt-get -qq install -y $need >/dev/null
        [ -z "$nodb" ] || apt-get -qq install -y libdb5.3-dev >/dev/null 2>&1 || true
        enddb
    fi
elif command -v dnf >/dev/null; then
    have() { rpm -q --whatprovides "$1"; }
    need=$(missing gcc make findutils openssl-devel zlib-devel shadow-utils procps-ng util-linux); report
    [ -z "$need" ] || dnf -q -y install $need >/dev/null
    if wantdb; then dnf -q -y install libdb-devel >/dev/null 2>&1 || true; enddb; fi
elif command -v zypper >/dev/null; then
    have() { rpm -q --whatprovides "$1"; }
    need=$(missing gcc make findutils libopenssl-devel zlib-devel shadow procps); report
    [ -z "$need" ] || zypper -n -q install $need >/dev/null
    if wantdb; then zypper -n -q install libdb-4_8-devel >/dev/null 2>&1 || true; enddb; fi
elif command -v pacman >/dev/null; then
    # base-devel is a group, not a package: -Q never finds it, so check the
    # group with -Qg (else -Syu would run on every call). -Q covers real packages.
    have() { pacman -Qg "$1" >/dev/null 2>&1 || pacman -Q "$1" >/dev/null 2>&1; }
    need=$(missing base-devel openssl zlib procps-ng); report
    nodb=; if wantdb; then nodb=1; fi
    if [ -n "$need" ] || [ -n "$nodb" ]; then
        # pacman 7 sandboxes downloads with Landlock, which containers may lack.
        nosandbox=
        pacman --help --sync 2>/dev/null | grep -q -- --disable-sandbox && nosandbox=--disable-sandbox
        # Arch is rolling and does not support partial upgrades: refresh and
        # upgrade the whole system once (-Syu), then install with -S. An older
        # cached/pinned base otherwise breaks on mismatched shared libraries.
        pacman -Syu --noconfirm --quiet $nosandbox >/dev/null
        [ -z "$need" ] || pacman -S --noconfirm --needed --quiet $nosandbox $need >/dev/null
        if [ -n "$nodb" ]; then
            pacman -S --noconfirm --needed --quiet $nosandbox db >/dev/null 2>&1 || true
            enddb
        fi
    fi
elif command -v apk >/dev/null; then
    have() { apk info -e "$1"; }
    need=$(missing build-base openssl-dev zlib-dev linux-headers procps); report
    [ -z "$need" ] || apk add -q $need
    if wantdb; then apk add -q db-dev 2>/dev/null || true; enddb; fi
elif command -v emerge >/dev/null; then
    # A stage3 has the compiler, OpenSSL and zlib.
    need=; report
    # procps (pgrep) for diablo-ctl, like the other package managers above.
    ls -d /var/db/pkg/sys-process/procps-* >/dev/null 2>&1 || \
        emerge --quiet --noreplace --getbinpkg sys-process/procps >/dev/null 2>&1 || true
    if wantdb && ! ls -d /var/db/pkg/sys-libs/db-[0-9]* >/dev/null 2>&1; then
        emerge --quiet --noreplace --getbinpkg sys-libs/db >/dev/null 2>&1 || true
        enddb
    fi
else
    echo "no supported package manager" >&2
    exit 1
fi

if ! getent group news >/dev/null; then
    if command -v groupadd >/dev/null; then groupadd -r news; else addgroup -S news; fi
fi
if ! id news >/dev/null 2>&1; then
    if command -v useradd >/dev/null; then
        useradd -r -g news -d /var/tmp -s /bin/sh news
    else
        adduser -S -G news -h /var/tmp -s /bin/sh news
    fi
fi

sed -i 's/^#define[[:space:]]*RADIUS_ENABLED/#undef RADIUS_ENABLED/' lib/vendor.h
# Cancel-Lock needs libcanlock (3.3.0 or later). Install it where the distribution has it;
# without it the feature is built out and the Cancel-Lock tests skip (Arch has no
# package for it in its official repositories, so it always falls back there).  With
# E2E_NO_CANLOCK=1 the feature is built out on purpose, so that the tests of the build
# without libcanlock (TestCancelLockWithoutLibcanlock) run: CI does one build of each.
if [ "${E2E_NO_CANLOCK:-}" != 1 ] && [ ! -e /usr/include/libcanlock-3/canlock.h ] && [ ! -e /usr/local/include/libcanlock-3/canlock.h ]; then
    if command -v apt-get >/dev/null; then apt-get -qq install -y libcanlock-dev >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null; then dnf -q -y install libcanlock-devel >/dev/null 2>&1 || true
    elif command -v zypper >/dev/null; then zypper -n -q install libcanlock-devel >/dev/null 2>&1 || true
    elif command -v apk >/dev/null; then apk add -q libcanlock-dev >/dev/null 2>&1 || true
    elif command -v emerge >/dev/null; then emerge --quiet --noreplace --getbinpkg net-libs/canlock >/dev/null 2>&1 || true
    fi
fi
if [ "${E2E_NO_CANLOCK:-}" = 1 ]; then
    sed -i 's/^#define[[:space:]]*CANLOCK_ENABLED/#undef CANLOCK_ENABLED/' lib/vendor.h
    echo "libcanlock: off (E2E_NO_CANLOCK=1)"
elif [ -e /usr/include/libcanlock-3/canlock.h ] || [ -e /usr/local/include/libcanlock-3/canlock.h ]; then
    echo "libcanlock: on"
else
    sed -i 's/^#define[[:space:]]*CANLOCK_ENABLED/#undef CANLOCK_ENABLED/' lib/vendor.h
    echo "build-on-host: WARNING: libcanlock is missing: CANLOCK_ENABLED is turned off, so the Cancel-Lock tests skip and, with the default readercanlock require-auth, this build refuses every cancel (install libcanlock-dev to test the feature)"
    echo "libcanlock: off (no libcanlock-3/canlock.h)"
fi
if [ -e /usr/include/db_185.h ]; then
    echo "berkeley db: on"
else
    sed -i -e 's/^#define[[:space:]]*DB_ENABLED/#undef DB_ENABLED/' \
        -e 's/^#define[[:space:]]*REJECT_DB.*/#undef REJECT_DB/' lib/vendor.h
    echo "berkeley db: off (no db_185.h)"
fi

# E2E_FAKE_SENDMAIL=1: install ci/fake-sendmail as /usr/sbin/sendmail for the
# moderation tests, where no sendmail exists or the only one is busybox's applet
# (Alpine symlinks /usr/sbin/sendmail to busybox, which cannot deliver the test
# mail); never replace a real MTA on a machine that sends real mail.
if [ "${E2E_FAKE_SENDMAIL:-}" = 1 ]; then
    sm=/usr/sbin/sendmail
    is_busybox=0
    if [ -L "$sm" ] && readlink -f "$sm" 2>/dev/null | grep -q busybox; then is_busybox=1; fi
    if [ ! -e "$sm" ] || [ "$is_busybox" = 1 ]; then
        # A busybox sendmail is a symlink to /bin/busybox, and busybox `install`
        # follows the destination symlink and overwrites its TARGET -- a plain
        # install would clobber /bin/busybox and break the system (GNU install
        # replaces the link itself, but Alpine has no GNU coreutils). Remove the
        # symlink first: that unlinks the link, never busybox, and install then
        # writes a fresh regular file where no symlink is followed.
        if [ "$is_busybox" = 1 ] && ! rm -f "$sm"; then
            echo "build-on-host: could not remove the $sm symlink; fake sendmail not installed" >&2
            exit 1
        fi
        if ! install -m 755 "$(dirname "$0")/fake-sendmail" "$sm"; then
            echo "build-on-host: could not install fake sendmail at $sm" >&2
            exit 1
        fi
        instpath=$(command -v install 2>/dev/null || echo install)
        instpath=$(readlink -f "$instpath" 2>/dev/null || echo "$instpath")
        bbmsg=""
        [ "$is_busybox" = 1 ] && bbmsg=" (replaced busybox applet)"
        echo "fake sendmail: installed as $sm$bbmsg (install: $instpath)"
    else
        echo "fake sendmail: not installed, $sm exists"
    fi
fi

MAKE=make; MAKEARGS=; CCBIN=cc

else  # FreeBSD / illumos (OmniOS): pkg, gmake, portable vendor.h editing

# The GNU Makefile needs gmake here (base `make` is BSD make on FreeBSD).
MAKE=gmake; MAKEARGS=

# In-place sed differs across systems (BSD sed wants `-i ''`, illumos /usr/bin/sed
# has no -i at all), so edit lib/vendor.h through a temp file, which any sed does.
vedit() { sed "$@" lib/vendor.h > lib/vendor.h.new && mv lib/vendor.h.new lib/vendor.h; }

case "$os" in
FreeBSD)
    echo "== FreeBSD $(freebsd-version 2>/dev/null || uname -r)"
    CCBIN=cc  # clang from base
    export ASSUME_ALWAYS_YES=yes
    # gmake is what the build needs beyond the base compiler, OpenSSL and zlib.
    pkg install -y gmake >/dev/null 2>&1 || pkg install -y gmake
    # libcanlock from pkg where available; if it is not, the feature is built
    # out below (as the gmake-only CI job did). Best effort -- a missing port
    # just leaves the header absent.
    if [ "${E2E_NO_CANLOCK:-}" != 1 ] \
        && [ ! -e /usr/local/include/libcanlock-3/canlock.h ]; then
        pkg install -y libcanlock >/dev/null 2>&1 || true
    fi
    pw groupadd news 2>/dev/null || true
    pw useradd news -g news -d /var/tmp -s /bin/sh 2>/dev/null || true
    ;;
SunOS)
    echo "== $(uname -srv)"
    CCBIN=gcc; MAKEARGS="CC=gcc"
    # OmniOS: gcc and GNU make from pkg; the base has OpenSSL and zlib.
    pkg install -q developer/gcc13 developer/build/gnu-make || \
        pkg install developer/gcc13 developer/build/gnu-make || true
    groupadd news 2>/dev/null || true
    useradd -g news -d /var/tmp -s /bin/sh news 2>/dev/null || true
    ;;
*)
    echo "build-on-host: no supported package manager for $os" >&2
    exit 1
    ;;
esac

# RADIUS: no library is wired up on these systems -> off.
vedit 's/^#define[[:space:]]*RADIUS_ENABLED/#undef RADIUS_ENABLED/'
# Cancel-Lock: on only when libcanlock's header is present (installed from pkg
# above where a package exists); otherwise built out, like a Linux host without it.
if [ "${E2E_NO_CANLOCK:-}" = 1 ]; then
    vedit 's/^#define[[:space:]]*CANLOCK_ENABLED/#undef CANLOCK_ENABLED/'
    echo "libcanlock: off (E2E_NO_CANLOCK=1)"
elif [ -e /usr/local/include/libcanlock-3/canlock.h ] || [ -e /usr/include/libcanlock-3/canlock.h ]; then
    echo "libcanlock: on"
else
    vedit 's/^#define[[:space:]]*CANLOCK_ENABLED/#undef CANLOCK_ENABLED/'
    echo "libcanlock: off (no libcanlock-3/canlock.h)"
fi
# Berkeley DB 1.85 API: the FreeBSD/illumos base systems ship no db_185.h -> off.
if [ -e /usr/include/db_185.h ] || [ -e /usr/local/include/db_185.h ]; then
    echo "berkeley db: on"
else
    vedit -e 's/^#define[[:space:]]*DB_ENABLED/#undef DB_ENABLED/' \
          -e 's/^#define[[:space:]]*REJECT_DB.*/#undef REJECT_DB/'
    echo "berkeley db: off (no db_185.h)"
fi

fi

# Shared build.  -k: one program that fails to build doesn't stop the others.
jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || getconf NPROCESSORS_ONLN 2>/dev/null || echo 1)
echo "cc: $($CCBIN --version 2>/dev/null | head -1)"
status=0
$MAKE -k -j"$jobs" $MAKEARGS > build.log 2>&1 || status=$?
echo "warnings: $(grep -c 'warning:' build.log || true)"
echo "errors: $(grep -c 'error:' build.log || true)"
ls dbin 2>/dev/null | wc -l | sed 's/^ */executables: /'
if [ $status -ne 0 ]; then
    grep -m 20 -E 'error:|Error [0-9]' build.log || tail -20 build.log
    exit 1
fi
