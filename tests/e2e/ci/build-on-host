#!/bin/sh

##  Install build packages and build Diablo for the e2e tests on a Linux
##  test machine.  Run as root from the top of a Diablo source tree copy:
##
##      tests/e2e/ci/build-on-host
##
##  This copy's lib/vendor.h is changed: RADIUS is turned off (Linux has no
##  BSD libradius), and DB_ENABLED and REJECT_DB are turned off when the
##  system has no Berkeley DB 1.85 API (db_185.h; several distributions
##  dropped Berkeley DB).  The binaries end up in dbin/.  The news user and
##  group are created when missing (diablo switches to them at startup).
##  With E2E_FAKE_SENDMAIL=1 the moderation tests' fake sendmail is installed
##  as /usr/sbin/sendmail where no sendmail exists (see ci/fake-sendmail).

set -eu

. /etc/os-release
echo "== $PRETTY_NAME"

# Packages are installed only when missing: have() is the distribution's own
# query for one package, and missing() lists those of its arguments not
# installed.  Berkeley DB is optional: install it where the distribution still
# has it.  wantdb() is true when db_185.h is absent and no earlier attempt
# failed; after an attempt, enddb() leaves a marker (outside the wiped build
# directory) if db_185.h is still absent, so later builds skip the attempt.
nodbmark=/var/tmp/diablo-e2e-no-berkeley-db
wantdb() {
    [ ! -e /usr/include/db_185.h ] || return 1
    if [ -e "$nodbmark" ]; then
        echo "build-on-host: berkeley db install skipped (failed before; rm $nodbmark to retry)"
        return 1
    fi
}
enddb() { [ -e /usr/include/db_185.h ] || { true > "$nodbmark"; } 2>/dev/null || true; }
missing() {
    for p; do have "$p" >/dev/null 2>&1 || printf '%s ' "$p"; done
}
report() {
    if [ -n "$need" ]; then echo "build-on-host: installing: $need"
    else echo "build-on-host: all packages present"; fi
}
if command -v apt-get >/dev/null; then
    have() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'ok installed'; }
    need=$(missing build-essential libssl-dev zlib1g-dev); report
    nodb=; if wantdb && ! have libdb5.3-dev; then nodb=1; fi
    if [ -n "$need" ] || [ -n "$nodb" ]; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get -qq update
        [ -z "$need" ] || apt-get -qq install -y $need >/dev/null
        [ -z "$nodb" ] || apt-get -qq install -y libdb5.3-dev >/dev/null 2>&1 || true
        enddb
    fi
elif command -v dnf >/dev/null; then
    have() { rpm -q --whatprovides "$1"; }
    need=$(missing gcc make findutils openssl-devel zlib-devel shadow-utils); report
    [ -z "$need" ] || dnf -q -y install $need >/dev/null
    if wantdb; then dnf -q -y install libdb-devel >/dev/null 2>&1 || true; enddb; fi
elif command -v zypper >/dev/null; then
    have() { rpm -q --whatprovides "$1"; }
    need=$(missing gcc make findutils libopenssl-devel zlib-devel shadow); report
    [ -z "$need" ] || zypper -n -q install $need >/dev/null
    if wantdb; then zypper -n -q install libdb-4_8-devel >/dev/null 2>&1 || true; enddb; fi
elif command -v pacman >/dev/null; then
    have() { pacman -Q "$1"; }
    need=$(missing base-devel openssl zlib); report
    nodb=; if wantdb; then nodb=1; fi
    if [ -n "$need" ] || [ -n "$nodb" ]; then
        # pacman 7 sandboxes downloads with Landlock, which containers may lack.
        nosandbox=
        pacman --help --sync 2>/dev/null | grep -q -- --disable-sandbox && nosandbox=--disable-sandbox
        [ -z "$need" ] || pacman -Sy --noconfirm --needed --quiet $nosandbox $need >/dev/null
        if [ -n "$nodb" ]; then
            # refresh the sync databases if the line above did not
            sync=-S; [ -n "$need" ] || sync=-Sy
            pacman $sync --noconfirm --needed --quiet $nosandbox db >/dev/null 2>&1 || true
            enddb
        fi
    fi
elif command -v apk >/dev/null; then
    have() { apk info -e "$1"; }
    need=$(missing build-base openssl-dev zlib-dev); report
    [ -z "$need" ] || apk add -q $need
    if wantdb; then apk add -q db-dev 2>/dev/null || true; enddb; fi
elif command -v emerge >/dev/null; then
    # A stage3 has the compiler, OpenSSL and zlib.
    need=; report
    if wantdb && ! ls -d /var/db/pkg/sys-libs/db-[0-9]* >/dev/null 2>&1; then
        emerge --quiet --noreplace --getbinpkg sys-libs/db >/dev/null 2>&1 || true
        enddb
    fi
else
    echo "no supported package manager" >&2
    exit 1
fi

if ! getent group news >/dev/null; then
    if command -v groupadd >/dev/null; then groupadd -r news; else addgroup -S news; fi
fi
if ! id news >/dev/null 2>&1; then
    if command -v useradd >/dev/null; then
        useradd -r -g news -d /var/tmp -s /bin/sh news
    else
        adduser -S -G news -h /var/tmp -s /bin/sh news
    fi
fi

sed -i 's/^#define[[:space:]]*RADIUS_ENABLED/#undef RADIUS_ENABLED/' lib/vendor.h
if [ -e /usr/include/db_185.h ]; then
    echo "berkeley db: on"
else
    sed -i -e 's/^#define[[:space:]]*DB_ENABLED/#undef DB_ENABLED/' \
        -e 's/^#define[[:space:]]*REJECT_DB.*/#undef REJECT_DB/' lib/vendor.h
    echo "berkeley db: off (no db_185.h)"
fi

# E2E_FAKE_SENDMAIL=1: install ci/fake-sendmail as /usr/sbin/sendmail for the
# moderation tests, but only where no sendmail exists (never on a machine that
# sends real mail).
if [ "${E2E_FAKE_SENDMAIL:-}" = 1 ]; then
    if [ -e /usr/sbin/sendmail ]; then
        echo "fake sendmail: not installed, /usr/sbin/sendmail exists"
    else
        install -m 755 "$(dirname "$0")/fake-sendmail" /usr/sbin/sendmail
        echo "fake sendmail: installed as /usr/sbin/sendmail"
    fi
fi

jobs=$(nproc 2>/dev/null || echo 1)
echo "cc: $(cc --version 2>/dev/null | head -1)"
# -k: one program that fails to build doesn't stop the others.
status=0
make -k -j"$jobs" > build.log 2>&1 || status=$?
echo "warnings: $(grep -c 'warning:' build.log || true)"
echo "errors: $(grep -c 'error:' build.log || true)"
ls dbin 2>/dev/null | wc -l | sed 's/^ */executables: /'
if [ $status -ne 0 ]; then
    grep -m 20 -E 'error:|Error [0-9]' build.log || tail -20 build.log
    exit 1
fi
