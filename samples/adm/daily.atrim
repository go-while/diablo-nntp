#!/bin/sh
#
# DAILY.ATRIM - rotate the logs, keeping 4 old copies of each.

# The directory with dpath, dexpire, ...: DIABLO_BIN, else dbin next to this
# script's directory (<path_home>/adm -> <path_home>/dbin; samples/adm in a source
# tree -> its dbin), else /news/dbin.  Every other path comes from diablo.config
# through dpath, so the news user's home directory doesn't matter.
set -u
here=$(cd "$(dirname "$0")" && pwd)
dbin=${DIABLO_BIN:-}
if [ -z "$dbin" ]; then
    for d in "$here/../dbin" "$here/../../dbin" /news/dbin; do
	[ -x "$d/dpath" ] && { dbin=$(cd "$d" && pwd); break; }
    done
fi
[ -n "$dbin" ] && [ -x "$dbin/dpath" ] || { echo "$0: no dpath found; set DIABLO_BIN" >&2; exit 1; }
home=$("$dbin/dpath" home) || exit 1
cd "$home" || exit 1

echo "$(date) - $0 BEGIN"

log=$("$dbin/dpath" log)
cd "$log" || exit 1
# A pattern that matches nothing stays as it is; rot skips it.
#
# general.log, incoming.log, drincoming.log, path.log and article.log are the logs
# diablo and dreaderd write themselves (path_generallog, path_incominglog,
# path_drincominglog, path_pathlog, path_artlog in diablo.config, under path_log).
# They can be moved while the daemons run: every write checks, at most every 10
# seconds, whether the file name still points at the file it has open, and opens
# the new file when it doesn't.  Up to 10 seconds of lines still go to the .0 file.
status=0
# The logs of the cron jobs (dbin/djoblog writes <job>.log) are rotated as well, and
# daily.log, which a crontab without djoblog still writes.  djoblog opens its log for
# each batch of lines, so this job's own log can be rotated while it runs.
"$here/rot" 4 daily.log hourly.expire.log daily.atrim.log biweekly.atrim.log \
    daily.reader.log weekly.reader.log actsync.log histbackup.log \
    dspoolout.log control.log miscctl \
    general.log incoming.log drincoming.log path.log article.log \
    newgroup*.alt newgroup*.other newgroup*.log \
    rmgroup*.alt rmgroup*.other rmgroup*.log \
    checkgroup*.alt checkgroup*.other checkgroup*.log || status=$?

# cron opened daily.log for this script before it started, and rot has just
# renamed that file to daily.log.0, so the messages of this run end up there.
# Make the new daily.log exist, for the jobs that append to it by name.
: >> daily.log

echo "$(date) - $0 END (exit status $status)"
exit $status
