#!/bin/sh
#
# BIWEEKLY.ATRIM - trim the history file (dhisexpire) and the server's active
# file (dkp -t).  Holds the same lock as hourly.expire, waiting for it, so
# the two never run at once.
#
#	ALWAYS RUN MANUALLY ONCE AFTER MAKING ANY CHANGE, TO BE SURE
#	THE SCRIPT STILL WORKS!

# The directory with dpath, dexpire, ...: DIABLO_BIN, else dbin next to this
# script's directory (<path_home>/adm -> <path_home>/dbin; samples/adm in a source
# tree -> its dbin), else /news/dbin.  Every other path comes from diablo.config
# through dpath, so the news user's home directory doesn't matter.
set -u
here=$(cd "$(dirname "$0")" && pwd)
dbin=${DIABLO_BIN:-}
if [ -z "$dbin" ]; then
    for d in "$here/../dbin" "$here/../../dbin" /news/dbin; do
	[ -x "$d/dpath" ] && { dbin=$(cd "$d" && pwd); break; }
    done
fi
[ -n "$dbin" ] && [ -x "$dbin/dpath" ] || { echo "$0: no dpath found; set DIABLO_BIN" >&2; exit 1; }
home=$("$dbin/dpath" home) || exit 1
cd "$home" || exit 1

if [ "${1:-}" != locked ]; then
    exec "$dbin/plock" "$home/.lock" "$here/$(basename "$0")" locked
fi

echo "$(date) - $0 BEGIN"

dhistory=$("$dbin/dpath" dhistory)
dactive=$("$dbin/dpath" server_dactive)

# Rebuild the history file without the entries expired more than
# 'remember' days ago (diablo.config); remove the old backup first to have
# more disk space to work with.  To change the hash table size, see hsize in
# diablo.config.
rm -f "$dhistory.new" "$dhistory.bak"
"$dbin/dhisexpire" -a "$dhistory"
status=$?

# Trim the server's active file.
[ -f "$dactive" ] && "$dbin/dkp" -t "$dactive"

echo "$(date) - $0 END (dhisexpire exit status $status)"
exit $status
