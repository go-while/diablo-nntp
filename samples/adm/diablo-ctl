#!/bin/sh
#
# DIABLO-CTL - start, stop, restart or show the status of diablo and dreaderd.
#
#	diablo-ctl [-C diablo.config] [-f diablo-ctl.conf] [-F] start|stop|restart|status|check [diablo|dreaderd|all]
#
#	"all" (the default) means the daemons listed in DIABLO_DAEMONS.
#
# Paths come from diablo.config (path_home, path_run, path_log ...), read
# through dpath, so this script never assumes /news.  The start options and
# the other settings come from diablo-ctl.conf: given with -f, or
# <path_home>/diablo-ctl.conf when it exists.  See samples/adm/diablo-ctl.conf.
#
# Run it as root (the daemons bind their port, then switch to the news user)
# or as the user the daemons run as.  POSIX sh.
#
# It only ever signals this site's processes, so several sites can run as
# the same user: the daemons through their control sockets (path_run) and
# their pid files in path_log (diablo.pid, dreaderd.pid), realtime dnewslink
# workers by their working directory (this site's path_dqueue).  A diablo
# too old to write diablo.pid is stopped through its control socket only.
#
# CHECKS BEFORE A START.  "start" (and restart) first runs these checks, which
# are ON unless DIABLO_PREFLIGHT="no" is set in diablo-ctl.conf, and does not
# start a daemon (exit status 1, every reason printed) when one fails:
#	- a mount point listed in DIABLO_MOUNTS is not mounted;
#	- the active file the daemon uses (dreaderd: always; diablo: only when
#	  diablo.config has "active" on) does not exist, or is older than
#	  DIABLO_ACTIVE_MAXAGE hours when that is set;
#	- unclean shutdown: the pid file is left, no process is running, and the
#	  activity log has not changed for DIABLO_MAX_DOWNTIME minutes (off
#	  unless that is set);
#	- the history file is missing and DIABLO_REQUIRE_HISTORY="yes" (by
#	  default a missing history is only noted: diablo makes a new one).
# A new site has no active file yet: create it (README.READER: dsyncgroups) or
# start once with -F.  "check" runs the checks and starts nothing.  -F skips
# them for this start.  See diablo-ctl.conf and samples/init/README.
#
# Exit status: 0 ok, 1 failure (check: a check failed), 2 usage, 3 status: a
# requested daemon is not running.

set -u

usage() {
    echo "usage: diablo-ctl [-C diablo.config] [-f diablo-ctl.conf] [-F] start|stop|restart|status|check [diablo|dreaderd|all]" >&2
    exit 2
}

say() { echo "diablo-ctl: $*"; }

conf=""
force=no
while getopts C:f:F opt; do
    case $opt in
	C)
	    # absolute: the script changes to path_home before starting
	    case $OPTARG in /*) DIABLO_CONFIG_PATH=$OPTARG ;; *) DIABLO_CONFIG_PATH=$(pwd)/$OPTARG ;; esac
	    export DIABLO_CONFIG_PATH ;;
	f) conf=$OPTARG ;;
	F) force=yes ;;
	*) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] && [ $# -le 2 ] || usage
action=$1
which=${2:-all}
case $action in start|stop|restart|status|check) ;; *) usage ;; esac
case $which in diablo|dreaderd|all) ;; *) usage ;; esac

# Settings, before the binary directory is known: a -f file may set DIABLO_BIN.
if [ -n "$conf" ]; then
    [ -r "$conf" ] || { say "cannot read $conf"; exit 1; }
    # "." searches PATH for a name without a slash
    case $conf in */*) ;; *) conf=./$conf ;; esac
    . "$conf"
fi

# The binaries: DIABLO_BIN, else ../dbin next to this script (an installed
# <home>/adm/diablo-ctl or the source tree's samples/adm), else /news/dbin.
if [ -z "${DIABLO_BIN:-}" ]; then
    here=$(cd "$(dirname "$0")" && pwd)
    for d in "$here/../dbin" "$here/../../dbin" /news/dbin; do
	if [ -x "$d/diablo" ]; then
	    DIABLO_BIN=$(cd "$d" && pwd)
	    break
	fi
    done
fi
[ -n "${DIABLO_BIN:-}" ] && [ -x "$DIABLO_BIN/dpath" ] || { say "no diablo binaries found; set DIABLO_BIN"; exit 1; }

home=$("$DIABLO_BIN/dpath" home) || { say "dpath cannot read diablo.config"; exit 1; }
logdir=$("$DIABLO_BIN/dpath" log) || { say "dpath cannot read diablo.config"; exit 1; }
dqueue=$(cd "$("$DIABLO_BIN/dpath" dqueue 2>/dev/null)" 2>/dev/null && pwd -P) || dqueue=""
if [ -z "$conf" ] && [ -r "$home/diablo-ctl.conf" ]; then
    . "$home/diablo-ctl.conf"
fi

DIABLO_DAEMONS=${DIABLO_DAEMONS:-diablo}
DIABLO_OPTS=${DIABLO_OPTS:-}
DREADERD_OPTS=${DREADERD_OPTS:-}
DIABLO_STOP_WAIT=${DIABLO_STOP_WAIT:-30}
DIABLO_START_WAIT=${DIABLO_START_WAIT:-30}
DIABLO_PS_PAD=${DIABLO_PS_PAD-60}
DIABLO_PREFLIGHT=${DIABLO_PREFLIGHT:-yes}
DIABLO_MOUNTS=${DIABLO_MOUNTS:-}
DIABLO_REQUIRE_HISTORY=${DIABLO_REQUIRE_HISTORY:-no}
DIABLO_ACTIVE_MAXAGE=${DIABLO_ACTIVE_MAXAGE:-}
DIABLO_MAX_DOWNTIME=${DIABLO_MAX_DOWNTIME:-}
DIABLO_DKP_TRIM=${DIABLO_DKP_TRIM:-no}
if [ -z "${DIABLO_USER:-}" ]; then
    if [ "$(id -u)" -eq 0 ]; then DIABLO_USER=news; else DIABLO_USER=$(id -un); fi
fi

if [ "$which" = all ]; then
    daemons=$DIABLO_DAEMONS
else
    daemons=$which
fi

# The status area for ps: "-s" plus DIABLO_PS_PAD spaces as one argument;
# diablo and dreaderd overwrite it with their status (as rc.news does it).
# Empty or 0: no status area.
pspad=""
case $DIABLO_PS_PAD in
    ''|0) ;;
    *[!0-9]*) say "DIABLO_PS_PAD must be a number of spaces"; exit 1 ;;
    *) pspad="-s$(printf "%${DIABLO_PS_PAD}s" "")" ;;
esac

# up <daemon>: the daemon answers on its control socket.  drcmd exits 1 even
# after a good "status" reply (dreaderd sends no "." terminator for it), so
# any reply on stdout counts too; without a daemon there is only an error on
# stderr.
up() {
    case $1 in
	diablo) cmd=dicmd ;;
	dreaderd) cmd=drcmd ;;
    esac
    reply=$("$DIABLO_BIN/$cmd" status 2>/dev/null) && return 0
    [ -n "$reply" ]
}

# masterpid <daemon>: the pid of this site's master process, from its pid
# file in path_log, or nothing.  Only a live process with the daemon's name
# counts.  Never "the oldest diablo of the user": that may be another site's.
masterpid() {
    pf="$logdir/$1.pid"
    [ -r "$pf" ] || return 0
    p=$(tr -dc '0-9' < "$pf")
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 0
    if [ -r "/proc/$p/comm" ]; then
	c=$(cat "/proc/$p/comm")		# Linux
    else
	c=$(ps -o comm= -p "$p" 2>/dev/null)	# BSD, illumos
    fi
    c=${c##*/}
    [ "$c" = "$1" ] || return 0
    # and only one of DIABLO_USER: the pid file is writable by that user
    [ "$(uidof "$p")" = "$(id -u "$DIABLO_USER" 2>/dev/null)" ] && echo "$p"
}

# uidof <pid>: the numeric uid a process runs as: the Uid: line of
# /proc/PID/status on Linux (the /proc/PID directory of a daemon that changed
# from root to news belongs to root), ps on illumos and the BSDs.
uidof() {
    if grep -q '^Uid:' "/proc/$1/status" 2>/dev/null; then
	awk '/^Uid:/ { print $2; exit }' "/proc/$1/status"
    else
	ps -o uid= -p "$1" 2>/dev/null | tr -d ' '
    fi
}

# pidtext <daemon>: the master's pid for messages.
pidtext() {
    p=$(masterpid "$1")
    echo "${p:-unknown}"
}

# cwdof <pid>: the working directory of a process, or nothing where the
# system doesn't tell (pwdx: Linux, illumos; /proc: Linux; procstat: FreeBSD).
cwdof() {
    if command -v pwdx >/dev/null 2>&1; then
	pwdx "$1" 2>/dev/null | sed -n 's/^[0-9]*:[[:space:]]*//p'
    elif [ -r "/proc/$1/cwd" ]; then
	readlink "/proc/$1/cwd" 2>/dev/null
    elif command -v procstat >/dev/null 2>&1; then
	procstat -h -f "$1" 2>/dev/null | awk '$3 == "cwd" { print $NF }'
    fi
}

# sitelinks: this site's dnewslink workers.  dspoolout starts them in
# path_dqueue and they stay there; workers of other sites, and workers whose
# working directory can't be read, are left alone.
sitelinks() {
    [ -n "$dqueue" ] || return 0
    for p in $(pgrep -x dnewslink -U "$DIABLO_USER" 2>/dev/null); do
	[ "$(cwdof "$p")" = "$dqueue" ] && echo "$p"
    done
}

# waitgone <pid> <seconds>: wait until pid has exited; 1 if it is still there.
waitgone() {
    n=0
    while kill -0 "$1" 2>/dev/null; do
	[ "$n" -ge "$2" ] && return 1
	sleep 1
	n=$((n + 1))
    done
    return 0
}

# older_than <file> <minutes>: the file was last changed more than that many
# minutes ago.  find without -mmin (illumos) rounds the limit up to whole days.
older_than() {
    [ -n "$(find "$1" -prune -mmin +"$2" -print 2>/dev/null)" ] && return 0
    find "$1" -prune -mmin 0 >/dev/null 2>&1 && return 1	# -mmin works: not older
    days=$((($2 + 1439) / 1440))
    [ -n "$(find "$1" -prune -mtime +"$((days - 1))" -print 2>/dev/null)" ]
}

# ismount <dir>: dir is a mount point (the "Mounted on" of df -P is dir itself).
ismount() {
    p=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    [ "$(df -P "$p" 2>/dev/null | awk 'NR == 2 { print $NF }')" = "$p" ]
}

# activefile <daemon>: the active file the daemon uses, if it needs one: for
# diablo only when diablo.config turns "active" on (or names the file).
activefile() {
    case $1 in
	dreaderd) "$DIABLO_BIN/dpath" reader_dactive ;;
	diablo)
	    cfg=${DIABLO_CONFIG_PATH:-$home/diablo.config}
	    v=$(awk '$1 == "active" { v = $2 } END { print v }' "$cfg" 2>/dev/null)
	    case $v in
		on) "$DIABLO_BIN/dpath" server_dactive ;;
		/*) echo "$v" ;;
	    esac ;;
    esac
}

# preflight <daemon>: the checks before a start.  Prints what is wrong and
# returns 1 when something is; a missing history file is only a note (diablo
# makes an empty one), unless DIABLO_REQUIRE_HISTORY says yes.
preflight() {
    d=$1
    bad=0
    for m in $DIABLO_MOUNTS; do
	ismount "$m" || { say "$d: $m is not mounted"; bad=1; }
    done
    if [ "$d" = diablo ]; then
	hist=$("$DIABLO_BIN/dpath" dhistory)
	if [ ! -f "$hist" ]; then
	    if [ "$DIABLO_REQUIRE_HISTORY" = yes ]; then
		say "$d: history file $hist not found (DIABLO_REQUIRE_HISTORY=yes); a new site makes one with: dbin/diload $hist </dev/null"
		bad=1
	    elif [ -f "$hist.snp" ] || [ -f "$hist.old" ]; then
		say "$d: note: $hist not found, but a snapshot is there ($hist.snp or $hist.old); diablo will start with an empty history unless you restore it"
	    fi
	fi
    fi
    act=$(activefile "$d")
    if [ -n "$act" ]; then
	if [ ! -f "$act" ]; then
	    say "$d: active file $act not found (a new site: create it, see README.READER, or start once with -F)"
	    bad=1
	elif [ -n "$DIABLO_ACTIVE_MAXAGE" ] && older_than "$act" $((DIABLO_ACTIVE_MAXAGE * 60)); then
	    say "$d: active file $act is more than $DIABLO_ACTIVE_MAXAGE hours old"
	    bad=1
	fi
    fi
    # A pid file without a process: the last run did not end with a stop of
    # diablo-ctl.  After a long downtime the spool and the history may be out
    # of step with the other servers, so ask for a person.
    pf="$logdir/$d.pid"
    if [ -n "$DIABLO_MAX_DOWNTIME" ] && [ -e "$pf" ] && [ -z "$(masterpid "$d")" ]; then
	case $d in diablo) alog=$logdir/article.log ;; dreaderd) alog=$logdir/drincoming.log ;; esac
	if [ -f "$alog" ] && older_than "$alog" "$DIABLO_MAX_DOWNTIME"; then
	    say "$d: unclean shutdown ($pf is left) and $alog has not changed for more than $DIABLO_MAX_DOWNTIME minutes; check the site, remove $pf and start with -F"
	    bad=1
	fi
    fi
    return $bad
}

# dkptrim <daemon>: trim and sort the active file (dkp -t, dkp -s) while no
# daemon of this site runs (dkp needs the file to itself).  As root the files
# are given back to their owner.
dkptrim() {
    [ "$DIABLO_DKP_TRIM" = yes ] || return 0
    if up diablo || up dreaderd; then
	say "$1: active file not trimmed: a daemon of this site is running"
	return 0
    fi
    case $1 in
	diablo) f=$("$DIABLO_BIN/dpath" server_dactive) ;;
	dreaderd) f=$("$DIABLO_BIN/dpath" reader_dactive) ;;
    esac
    [ -f "$f" ] || return 0
    owner=$(ls -ldn "$f" | awk '{ print $3 ":" $4 }')
    "$DIABLO_BIN/dkp" -t "$f" >/dev/null && "$DIABLO_BIN/dkp" -s "$f" >/dev/null || say "$1: dkp could not trim and sort $f"
    [ "$(id -u)" -eq 0 ] && chown "$owner" "$f"
    return 0
}

start_one() {
    d=$1
    if up "$d"; then
	say "$d is already running (pid $(pidtext "$d"))"
	return 0
    fi
    if [ "$force" != yes ] && [ "$DIABLO_PREFLIGHT" = yes ]; then
	preflight "$d" || { say "$d not started: a check failed (diablo-ctl -F start skips the checks once, DIABLO_PREFLIGHT=no in diablo-ctl.conf turns them off; see samples/init/README)"; return 1; }
    fi
    dkptrim "$d"
    [ -n "${DIABLO_NOFILE:-}" ] && ulimit -n "$DIABLO_NOFILE"
    # Start in path_home, as rc.news does (dreaderd keeps its cwd).
    cd "$home" || { say "cannot cd to $home"; return 1; }
    case $d in
	# Both detach themselves (they fork and the parent exits).
	diablo)
	    if [ -n "$pspad" ]; then
		"$DIABLO_BIN/diablo" $DIABLO_OPTS server "$pspad"
	    else
		"$DIABLO_BIN/diablo" $DIABLO_OPTS server
	    fi ;;
	dreaderd)
	    if [ -n "$pspad" ]; then
		"$DIABLO_BIN/dreaderd" $DREADERD_OPTS "$pspad"
	    else
		"$DIABLO_BIN/dreaderd" $DREADERD_OPTS
	    fi ;;
    esac || { say "$d did not start (exit status $?)"; return 1; }
    n=0
    until up "$d"; do
	if [ "$n" -ge "$DIABLO_START_WAIT" ]; then
	    say "$d does not answer on its control socket after ${DIABLO_START_WAIT}s"
	    return 1
	fi
	sleep 1
	n=$((n + 1))
    done
    say "$d started (pid $(pidtext "$d"))"
}

stop_one() {
    d=$1
    pid=$(masterpid "$d")
    if [ -z "$pid" ] && ! up "$d"; then
	say "$d is not running"
	return 0
    fi
    # Remember the children: once the master is gone they are not its
    # children any more.
    kids=""
    [ -n "$pid" ] && kids=$(pgrep -P "$pid" 2>/dev/null | tr '\n' ' ')
    case $d in
	diablo) "$DIABLO_BIN/dicmd" exit >/dev/null 2>&1 ;;
	dreaderd) "$DIABLO_BIN/drcmd" exit >/dev/null 2>&1 ;;
    esac
    if [ -n "$pid" ]; then
	if ! waitgone "$pid" "$DIABLO_STOP_WAIT"; then
	    say "$d (pid $pid) still running after ${DIABLO_STOP_WAIT}s: SIGTERM"
	    kill -TERM "$pid" 2>/dev/null
	    if ! waitgone "$pid" 5; then
		say "$d (pid $pid) still running: SIGKILL"
		kill -KILL "$pid" 2>/dev/null
		waitgone "$pid" 5 || { say "cannot stop $d (pid $pid)"; return 1; }
	    fi
	fi
    else
	# No pid file: wait until the control socket stops answering, but
	# signal nothing (whatever pgrep finds may belong to another site).
	n=0
	while up "$d"; do
	    if [ "$n" -ge "$DIABLO_STOP_WAIT" ]; then
		say "$d still answers after ${DIABLO_STOP_WAIT}s and has no pid file in $logdir; stop it by hand"
		return 1
	    fi
	    sleep 1
	    n=$((n + 1))
	done
    fi
    for k in $kids; do
	kill -0 "$k" 2>/dev/null && kill -TERM "$k" 2>/dev/null
    done
    if [ "$d" = diablo ]; then
	# Realtime dnewslink workers (started by dspoolout) keep running
	# without diablo; stop this site's.  dspoolout from cron starts them
	# again.
	links=$(sitelinks)
	if [ -n "$links" ]; then
	    kill -TERM $links 2>/dev/null
	    n=0
	    while [ -n "$(sitelinks)" ] && [ "$n" -lt 10 ]; do
		sleep 1
		n=$((n + 1))
	    done
	fi
    fi
    # dreaderd leaves its pid file behind: only a pid file without a process
    # means that the last run did not end with a stop (see DIABLO_MAX_DOWNTIME)
    [ -n "$(masterpid "$d")" ] || rm -f "$logdir/$d.pid"
    say "$d stopped"
}

status_one() {
    d=$1
    if up "$d"; then
	case $d in
	    diablo) line=$("$DIABLO_BIN/dicmd" status 2>/dev/null | head -1) ;;
	    dreaderd) line=$("$DIABLO_BIN/drcmd" status 2>/dev/null | head -1) ;;
	esac
	say "$d is running (pid $(pidtext "$d")): $line"
	return 0
    fi
    say "$d is not running"
    return 3
}

rc=0
case $action in
    start)
	for d in $daemons; do start_one "$d" || rc=1; done ;;
    stop)
	# The reader first: it may fetch articles from the local feeder.
	for d in dreaderd diablo; do
	    case " $daemons " in *" $d "*) stop_one "$d" || rc=1 ;; esac
	done ;;
    restart)
	for d in dreaderd diablo; do
	    case " $daemons " in *" $d "*) stop_one "$d" || rc=1 ;; esac
	done
	[ $rc -eq 0 ] && for d in $daemons; do start_one "$d" || rc=1; done ;;
    status)
	for d in $daemons; do status_one "$d" || rc=3; done ;;
    check)
	for d in $daemons; do
	    if preflight "$d"; then say "$d: checks passed"; else rc=1; fi
	done ;;
esac
exit $rc
