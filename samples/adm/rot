#!/bin/sh
#
# ROT <n> <file>... - rotate each file: file.<n-1> -> file.<n>, ...,
# file.0 -> file.1, file -> file.0.  Files that don't exist are skipped.

[ $# -ge 2 ] || { echo "usage: rot <n> <file>..." >&2; exit 2; }
n=$1
shift
for f in "$@"; do
    j=$n
    while [ "$j" -gt 0 ]; do
	p=$((j - 1))
	if [ -f "$f.$p" ]; then
	    mv -f "$f.$p" "$f.$j"
	else
	    rm -f "$f.$j"
	fi
	j=$p
    done
    if [ -f "$f" ]; then
	mv -f "$f" "$f.0"
    fi
done
