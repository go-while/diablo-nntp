<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<!--
  diablo.xml - Diablo NNTP feeder, for illumos and SmartOS (SMF).
  See samples/init/README.  Paths assume the install prefix /news and its
  diablo.config; for another prefix add -C <prefix>/diablo.config to the exec
  attributes (diablo-ctl -C <prefix>/diablo.config start diablo).
    svccfg import diablo.xml
    svcadm enable site/diablo
-->
<service_bundle type="manifest" name="diablo">
  <service name="site/diablo" type="service" version="1">
    <create_default_instance enabled="false"/>
    <single_instance/>

    <dependency name="network" grouping="require_all" restart_on="error" type="service">
      <service_fmri value="svc:/milestone/network:default"/>
    </dependency>
    <dependency name="filesystem" grouping="require_all" restart_on="error" type="service">
      <service_fmri value="svc:/system/filesystem/local"/>
    </dependency>

    <!-- diablo-ctl starts the daemon, which detaches; it lives in the contract of the service -->
    <exec_method type="method" name="start" exec="/news/adm/diablo-ctl start diablo" timeout_seconds="120"/>
    <exec_method type="method" name="stop" exec="/news/adm/diablo-ctl stop diablo" timeout_seconds="150"/>

    <property_group name="startd" type="framework">
      <propval name="duration" type="astring" value="contract"/>
      <propval name="ignore_error" type="astring" value="core,signal"/>
    </property_group>

    <stability value="Unstable"/>
    <template>
      <common_name>
        <loctext xml:lang="C">Diablo NNTP feeder</loctext>
      </common_name>
    </template>
  </service>
</service_bundle>
